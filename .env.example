# Copy to .env; use your own local database and random session signing key.
DATABASE_URL=postgresql://postgres:replace-me@localhost:5432/barbershop_queue?schema=public
SESSION_SECRET=
SHOP_NAME=
SHOP_SLUG=
SHOP_ADMIN_EMAIL=owner@example.com
SHOP_ADMIN_PASSWORD=
# Optional: set both to bootstrap a separate superadmin.
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=
